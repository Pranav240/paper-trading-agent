__pycache__/
*.pyc
.venv/
papertrading/
.env
.pytest_cache/
*.egg-info/
.DS_Store
smoke_test.py
data/
# ...except the symbol list: 108 lines, but regenerating it means a
# ten-minute scan of a 23GB CSV, so it belongs in version control.
!data/fnspid_symbols.txt

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# hashes, which is what makes an apply reproducible across machines.

# Console screenshots kept locally as portfolio evidence. They carry the AWS
# account id, instance ids and role ARNs — not credentials, but not worth
# publishing on a public repo either.
AWS_Screenshots/

# The public demo snapshot is generated, committed JSON (scripts/export_public_snapshot.py)
# so CI never needs a database. The rule above would otherwise swallow it.
!docs/data/
_site/
