# Copy to .env and fill in real values. .env is gitignored — never commit it.

DATABASE_URL=postgresql://pta:pta_dev_password@127.0.0.1:5432/paper_trading_agent

# OpenAI — used by the Portfolio Manager node for decision synthesis,
# and (as a sandbox-environment workaround — see docs/backtesting-plan.md
# and app/agent/sentiment_analyst.py) by the Sentiment Analyst node too.
OPENAI_API_KEY=

# Alpaca paper trading account — used for both historical/live price
# bars (Technical Analyst) and historical/live news (Sentiment Analyst).
# Free tier: alpaca.markets -> Paper Trading -> API Keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
